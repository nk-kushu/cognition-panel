{
  "agentId": "coding",
  "schema": {
    "limits": [
      {
        "key": "clarifications",
        "label": "Mode clarifications",
        "min": 0,
        "max": 16
      },
      {
        "key": "investigationReturns",
        "label": "Investigation returns",
        "min": 0,
        "max": 16
      },
      {
        "key": "planRevisions",
        "label": "Plan revisions",
        "min": 0,
        "max": 16
      },
      {
        "key": "skeletonRevisions",
        "label": "Skeleton revisions",
        "min": 0,
        "max": 16
      },
      {
        "key": "codeFixReturns",
        "label": "Code-fix returns (guards and tests share these)",
        "min": 0,
        "max": 16
      },
      {
        "key": "totalReturns",
        "label": "Total returns per run",
        "min": 0,
        "max": 32
      },
      {
        "key": "answerRounds",
        "label": "Answer-only investigation rounds",
        "min": 1,
        "max": 8
      },
      {
        "key": "runMinutes",
        "label": "Working minutes per run",
        "min": 1,
        "max": 230
      },
      {
        "key": "modelCalls",
        "label": "Model calls per run",
        "min": 1,
        "max": 5000
      },
      {
        "key": "inputTokens",
        "label": "Input tokens per run",
        "min": 1000,
        "max": 100000000
      }
    ],
    "models": [
      {
        "key": "default",
        "label": "Default"
      },
      {
        "key": "investigationPlanning",
        "label": "Investigation"
      },
      {
        "key": "implementation",
        "label": "Implementation"
      },
      {
        "key": "guardReview",
        "label": "Guard review"
      },
      {
        "key": "skillScheduler",
        "label": "Skill scheduler"
      },
      {
        "key": "answer",
        "label": "Answer-only"
      }
    ],
    "defaultModelKey": "default",
    "overviewLimits": ["totalReturns", "runMinutes", "modelCalls", "inputTokens"],
    "totalReturnsKey": "totalReturns",
    "verificationBlockedMessage": "A code change will stop.",
    "modes": [
      {
        "value": "",
        "label": "Automatic (JEV decides)"
      },
      {
        "value": "answer-only",
        "label": "Explain only"
      },
      {
        "value": "code-change",
        "label": "Change the code"
      }
    ],
    "steps": [
      {
        "id": "mode",
        "title": "Choose mode",
        "summary": "Honors an explicit choice, otherwise asks JEV. Waits for clarification if unclear.",
        "branch": "any",
        "worker": "jev",
        "models": [],
        "limits": ["clarifications"],
        "pauses": true,
        "returns": [],
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "answer-prepare",
        "title": "Prepare questions",
        "summary": "Lists what must be read to answer the request.",
        "branch": "answer-only",
        "worker": "model",
        "models": ["investigationPlanning"],
        "limits": [],
        "pauses": false,
        "returns": [],
        "laneLabel": "Explain",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "answer-investigate",
        "title": "Investigate",
        "summary": "Reads the selected files read-only, one round of questions at a time.",
        "branch": "answer-only",
        "worker": "model",
        "models": ["investigationPlanning"],
        "limits": ["answerRounds"],
        "pauses": false,
        "returns": [],
        "laneLabel": "Explain",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "answer-write",
        "title": "Write answer",
        "summary": "Writes the answer from the evidence and reports what stayed unresolved.",
        "branch": "answer-only",
        "worker": "model",
        "models": ["answer", "skillScheduler"],
        "limits": [],
        "skillPhase": "answer",
        "pauses": true,
        "returns": [],
        "laneLabel": "Explain",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "plan-investigation",
        "title": "Plan investigation",
        "summary": "One session lists the questions to answer.",
        "branch": "code-change",
        "worker": "model",
        "models": ["investigationPlanning"],
        "limits": [],
        "pauses": true,
        "returns": [],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "investigate",
        "title": "Investigate",
        "summary": "For each question: names only, JEV selection, then reading the selected files.",
        "branch": "code-change",
        "worker": "model",
        "models": ["investigationPlanning"],
        "limits": [],
        "pauses": true,
        "returns": ["investigation"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "plan-implementation",
        "title": "Plan implementation",
        "summary": "Runs scheduled skills, then produces the plan.",
        "branch": "code-change",
        "worker": "model",
        "models": ["default", "skillScheduler"],
        "limits": [],
        "skillPhase": "planning",
        "pauses": true,
        "returns": ["investigation"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "write-tests",
        "title": "Write tests",
        "summary": "One session per behavior; may touch only its test files.",
        "branch": "code-change",
        "worker": "model",
        "models": ["implementation", "skillScheduler"],
        "limits": [],
        "skillPhase": "test-writing",
        "pauses": true,
        "returns": ["investigation", "plan"],
        "laneLabel": "Change the code",
        "showTestPrompt": true,
        "showTests": true
      },
      {
        "id": "skeleton",
        "title": "Skeleton",
        "summary": "One session per component; declarations only. Its guards run before your review.",
        "branch": "code-change",
        "worker": "model",
        "models": ["implementation", "skillScheduler"],
        "limits": [],
        "skillPhase": "skeleton",
        "guardPhase": "skeleton",
        "pauses": true,
        "returns": ["investigation", "plan", "skeleton"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "human-review",
        "title": "Human review",
        "summary": "No model. Waits for your approval of the exact version shown.",
        "branch": "code-change",
        "worker": "human",
        "models": [],
        "limits": [],
        "pauses": true,
        "returns": ["investigation", "plan", "skeleton"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false,
        "guidance": {
          "title": "Your choices",
          "text": "Approve continues to implementation. Request changes returns to the skeleton, and Change the plan returns to planning. Cancel ends the run."
        }
      },
      {
        "id": "implement",
        "title": "Implement",
        "summary": "One session per change; only the assigned method bodies may change.",
        "branch": "code-change",
        "worker": "model",
        "models": ["implementation", "skillScheduler"],
        "limits": [],
        "skillPhase": "implementation",
        "pauses": true,
        "returns": ["investigation", "plan"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "guards",
        "title": "Guards",
        "summary": "Runs saved commands and model reviews through kushibot's guard framework.",
        "branch": "code-change",
        "worker": "command",
        "models": ["guardReview"],
        "limits": [],
        "guardPhase": "guards",
        "pauses": false,
        "returns": ["investigation", "plan", "code-fix"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": false
      },
      {
        "id": "run-tests",
        "title": "Run tests",
        "summary": "Runs registered suites directly.",
        "branch": "code-change",
        "worker": "command",
        "models": [],
        "limits": [],
        "pauses": false,
        "returns": ["investigation", "plan", "code-fix"],
        "laneLabel": "Change the code",
        "showTestPrompt": false,
        "showTests": true
      }
    ],
    "routes": {
      "investigation": {
        "target": "investigate",
        "limit": "investigationReturns",
        "summary": "Evidence is missing, so the run asks a new question and reads more of the code.",
        "label": "Investigation returns"
      },
      "plan": {
        "target": "plan-implementation",
        "limit": "planRevisions",
        "summary": "The design is wrong, so the run revises the plan.",
        "label": "Plan revisions"
      },
      "skeleton": {
        "target": "skeleton",
        "limit": "skeletonRevisions",
        "summary": "The declarations need another revision, from a failed check or your review.",
        "label": "Skeleton revisions"
      },
      "code-fix": {
        "target": "implement",
        "limit": "codeFixReturns",
        "summary": "A guard or test found a code defect, so the run repairs it. Both share this limit.",
        "label": "Code-fix returns"
      }
    },
    "skillPhases": [
      {
        "value": "planning"
      },
      {
        "value": "test-writing"
      },
      {
        "value": "skeleton"
      },
      {
        "value": "implementation"
      },
      {
        "value": "answer"
      }
    ],
    "guardPhases": [
      {
        "value": "skeleton",
        "label": "Skeleton, before review"
      },
      {
        "value": "guards",
        "label": "Finished change"
      }
    ],
    "skillInputs": [
      {
        "value": "findings"
      },
      {
        "value": "plan"
      },
      {
        "value": "tests"
      },
      {
        "value": "skeleton"
      },
      {
        "value": "approval"
      }
    ],
    "newDefinitions": {
      "skill": {
        "name": "New skill",
        "purpose": "What this skill is for.",
        "instructions": "What the skill should do.",
        "phases": ["planning"],
        "dependencies": [],
        "requiredInputs": [],
        "expectedResult": "",
        "selection": "automatic",
        "model": ""
      },
      "guard": {
        "name": "New guard",
        "purpose": "What this guard checks.",
        "type": "deterministic",
        "phases": ["guards"],
        "selection": "automatic",
        "blocking": true,
        "reviewInstructions": "",
        "model": "",
        "check": {
          "command": "npm",
          "args": ["run", "lint", "--", "--max-warnings=0"],
          "script": "",
          "workingDirectory": ".",
          "timeoutMs": 120000,
          "successExitCodes": [0]
        }
      }
    },
    "builtInDefinitions": {
      "skill": [],
      "guard": []
    }
  },
  "defaults": {
    "limits": {
      "clarifications": 2,
      "investigationReturns": 3,
