// Kushex application tables. Kushibot framework stores own their `kushibot_*` tables
// and are not modelled here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["kushex"]
}

model Project {
  id          String     @id @default(uuid()) @db.Uuid
  actorId     String
  name        String     @db.VarChar(200)
  description String?    @db.VarChar(2000)
  createdAt   DateTime   @default(now())
  workspace   Workspace?
  chatThreads ChatThread[]
  agentSettings    AgentProjectSettings[]
  agentDefinitions AgentDefinition[]
  agentRunWaits    AgentRunWait[]

  @@index([actorId, createdAt, id])
  @@schema("kushex")
}

model ChatThread {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  actorId   String
  title     String     @db.VarChar(200)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  turns     ChatTurn[]

  @@index([actorId, projectId, updatedAt])
  @@schema("kushex")
}

model ChatTurn {
  id        String     @id @db.Uuid
  threadId  String     @db.Uuid
  agentName String     @db.VarChar(63)
  message   String
  files     Json
  debug     Boolean
  events    Json
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt, id])
  @@schema("kushex")
}

model Workspace {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @db.Uuid
  path      String  @db.VarChar(4096)
  branch    String?
  revision  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@schema("kushex")
}

// Settings belong to the request actor, independently of projects and panel instances.
enum ColorMode {
  system
  light
  dark

  @@schema("kushex")
}

enum Density {
  comfortable
  compact

  @@schema("kushex")
}

model UserSettings {
  actorId   String    @id
  colorMode ColorMode @default(system)
  density   Density   @default(comfortable)
  /// Pixels, for every Monaco editor in the panel.
  editorFontSize Int  @default(13)
  /// Pixels, for the code notes of the agent editor.
  noteFontSize Int    @default(13)
  /// Splitter id → panel fractions; PATCH merges by id.
  splitterSizes Json  @default("{}")
  updatedAt DateTime  @updatedAt

  @@schema("kushex")
}

// An agent's code notes as one markdown document, in the format of the UI's `serializeNotes`.
model AgentCodeNotes {
  agentName String   @id @db.VarChar(63)
  content   String
  /// Bumped on every save; a save must name the revision it was based on.
  revision  Int
  updatedAt DateTime @updatedAt

  @@schema("kushex")
}

// The kushibot debug-event streams a chat run produced. The events themselves are kushibot's:
// `kushibot.kushibot_debug_events`, written through kushibot's SqlDebugEventStore. A stream
// belongs to one run.
model AgentRunDebugStream {
  scopeId        String   @db.VarChar(256)
  scopeProjectId String   @db.VarChar(256)
  streamId       String   @db.VarChar(300)
  workspaceId    String?  @db.VarChar(256)
  runId          String   @db.Uuid
  actorId        String
  projectId      String   @db.Uuid
  agentName      String   @db.VarChar(63)
  runStartedAt   DateTime
  createdAt      DateTime @default(now())

  @@id([scopeId, scopeProjectId, streamId])
  @@index([runId, createdAt])
  @@schema("kushex")
}

// A markdown note of the Notes page. `title` is derived from the content's first line.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String
  title     String   @db.VarChar(200)
  content   String
  pinned    Boolean  @default(false)
  /// Bumped on every content save; a save must name the revision it was based on.
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorId, pinned, updatedAt])
  @@schema("kushex")
}

// An agent's settings for one project, for example the coding agent's limits and models.
model AgentProjectSettings {
  projectId String   @db.Uuid
  agentType String   @db.VarChar(63)
  settings  Json
  /// Bumped on every save; a save must name the revision it was based on.
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, agentType])
  @@schema("kushex")
}

enum AgentDefinitionKind {
  skill
  guard

  @@schema("kushex")
}

// A skill or guard managed in the UI. Each save adds a version, so a run pins exactly what it
// used and deleting keeps the versions that past runs refer to.
model AgentDefinition {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @db.Uuid
  agentType String              @db.VarChar(63)
  kind      AgentDefinitionKind
  enabled   Boolean             @default(true)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  AgentDefinitionVersion[]

  @@index([projectId, agentType, kind])
  @@schema("kushex")
}

model AgentDefinitionVersion {
  id           String          @id @default(uuid()) @db.Uuid
  definitionId String          @db.Uuid
  version      Int
  content      Json
  createdAt    DateTime        @default(now())
  definition   AgentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version])
  @@schema("kushex")
}

enum AgentWaitStatus {
  pending
  answered
  cancelled

  @@schema("kushex")
}

// A run suspended on a human. Its id is the chat run that asked; the agent process has ended,
// so this row and the run's files are what survive a reload or a server restart.
model AgentRunWait {
  id           String          @id @db.Uuid
  projectId    String          @db.Uuid
  actorId      String
  agentName    String          @db.VarChar(63)
  threadId     String?         @db.Uuid
  /// The agent's own run, which `resume` reopens.
  agentRunRef  String          @db.VarChar(120)
  waitRef      String          @db.VarChar(120)
  kind         String          @db.VarChar(32)
  payload      Json
  status       AgentWaitStatus @default(pending)
  response     Json?
  createdAt    DateTime        @default(now())
  answeredAt   DateTime?
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@schema("kushex")
}

// One replaceable OpenRouter credential per local operator. Never returned to the UI.
model OpenRouterCredential {
  actorId      String   @id
  encryptedKey String
  updatedAt    DateTime @updatedAt

  @@schema("kushex")
}
